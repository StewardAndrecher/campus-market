# 本文件仅包含本地演示值。复制为 .env 后再修改，真实凭据不得提交。
MYSQL_ROOT_PASSWORD=campus_root_password
MYSQL_PORT=3307
DB_URL=jdbc:mysql://127.0.0.1:3307/campus_market
DB_USERNAME=campus
DB_PASSWORD=campus_dev_password
DB_MIGRATION_ENABLED=true

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
LOGIN_REDIS_HOST=127.0.0.1
LOGIN_REDIS_PORT=6380

RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673
RABBITMQ_USERNAME=campus_mq
RABBITMQ_PASSWORD=campus_mq_password
RABBITMQ_VHOST=/campus-market
ORDER_MQ_ENABLED=true
NOTIFICATION_MQ_ENABLED=true

# 仅用于本地教学演示，不调用真实支付渠道。
ORDER_SIMULATED_PAYMENT_ENABLED=true
ORDER_TIMEOUT_SWEEP_ENABLED=true
UPLOAD_DIR=./data/uploads
API_DOCS_ENABLED=true
EMAIL_ENABLED=false
